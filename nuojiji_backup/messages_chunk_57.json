落下去，勾住她搭在腿弯上的毯子往上提了提，掌心顺势在她膝头不轻不重地捏了一下，整个人透着一股被占了便宜却又甘之如饴的散漫。","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757341988,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"type":"state","translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":15902},{"id":1792736880305,"text":"刚才还敢当面给我降辈分","rawContent":"刚才还敢当面给我降辈分","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757342271,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":15903},{"id":1792736880306,"text":"现在一声好听的就想全翻篇了？","rawContent":"现在一声好听的就想全翻篇了？","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757342285,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":15904},{"id":1792736880307,"text":"不过呢","rawContent":"不过呢","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757342532,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":15905},{"id":1792736880308,"text":"比起刚才那个离谱的称呼","rawContent":"比起刚才那个离谱的称呼","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757342589,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":15906},{"id":1792736880309,"text":"这个确实勉强能听","rawContent":"这个确实勉强能听","isHtml":false,"sticker":null,"sender":"them","time":"20:09","timestamp":1792757342904,"roundId":"round_1792757074730_eq5obnxhq","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":