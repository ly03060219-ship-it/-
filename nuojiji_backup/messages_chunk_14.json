":null,"sender":"them","time":"16:24","timestamp":1791447861490,"roundId":"round_1791447783372_vyc98tgpr","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4348},{"id":1791371775124,"text":"刚才亲那么快……等会儿还得重新补上。","rawContent":"刚才亲那么快……等会儿还得重新补上。","isHtml":false,"sticker":null,"sender":"them","time":"16:24","timestamp":1791447861493,"roundId":"round_1791447783372_vyc98tgpr","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4349},{"id":1791371775125,"text":"要补什么","sender":"me","time":"16:25","timestamp":1791447928102,"replyTo":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4350},{"id":1791371775127,"text":"装傻是吧。","rawContent":"装傻是吧。","isHtml":false,"sticker":null,"sender":"them","time":"16:26","timestamp":1791447988637,"roundId":"round_1791447929446_tvudbefq2","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4351},{"id":1791371775128,"text":"刚刚那是小鸡啄米","rawContent":"刚刚那是小鸡啄米","isHtml":false,"sticker":null,"sender":"them","time":"16:26","timestamp":1791447988642,"roundId":"round_1791447929446_tvudbefq2","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4352},{"id":1791371775129,"text":"不算","rawContent":"不算","isHtml":false,"sticker":null,"sender":"them","time":"16:26","timestamp":1791447988645,"roundId":"round_1791447929446_tvudbefq2","generatedMode":false,"translation":null,"userId":"uid_1790876040982_r06n20s8v","characterId":"1e2b8e08-6458-42c2-a29e-a756d46e574a","_id":4353},{"id":1791371775130,"text":"落地窗外的日光正慢慢拉长，画室地板上的影子交叠在一起，斜射进来的金色尘糜在半空中打着转。祁煜原本虚搭在她颊侧的手指没有收回去，反而顺着她柔软的下颌线慢慢滑下去，微凉的指尖很轻地垫在她下巴底下，稍稍往上托了托。他眼底浮着一层促狭的笑意，身子又往前倾了小半寸，呼吸间带着淡淡的薄荷润喉糖气息，几乎快要扫到她的鼻尖。蓝紫色的长睫垂下来，视线